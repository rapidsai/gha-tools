#!/bin/bash
# A utility script that generates a package version
set -euo pipefail
export RAPIDS_SCRIPT_NAME="rapids-generate-version"

if [[ "${RAPIDS_BUILD_TYPE:-}" == "release-candidate" ]]; then
    if [[ -s VERSION ]]; then
        candidate_version="$(head -n 1 VERSION)"
    elif git cat-file -e HEAD:VERSION 2>/dev/null; then
        # Some build scripts redirect this command's output back to VERSION,
        # which truncates the working file before this script starts.
        candidate_version="$(git show HEAD:VERSION | sed -n '1p')"
    else
        echo "release-candidate builds require a non-empty VERSION file in the working tree or at HEAD" >&2
        exit 1
    fi
    readonly candidate_version
    readonly candidate_version_regex='^[0-9]+\.[0-9]+(\.[0-9]+)?$'
    if [[ ! "${candidate_version}" =~ ${candidate_version_regex} ]]; then
        echo "release-candidate VERSION must use a numeric YY.MM or YY.MM.XX format, got '${candidate_version}'" >&2
        exit 1
    fi
    echo -n "${candidate_version}"
    exit 0
fi

if rapids-is-release-build; then
    dunamai_version=$(python -m dunamai from git --format "{base}")
else
    # Non-release builds include the distance from the last tag as the alpha version.
    # We use Python to detect whether the nearest tag has a stage (e.g., "a" for alpha).
    # If it does, use {base}{stage}{distance} (e.g., "25.12.00a62").
    # If it doesn't (nearest tag is a release like v25.10.00), the stage is empty and
    # {base}{stage}{distance} would produce garbage (e.g., "25.10.000"). In that case,
    # we default to "rc" as the stage separator (e.g., "25.10.00rc0").
    dunamai_version=$(python -c "
from dunamai import Version
v = Version.from_git()
if v.stage:
    print(v.serialize(format='{base}{stage}{distance}'))
else:
    print(v.serialize(format='{base}rc{distance}'))
")

    # In some cases (like nightly builds), an additional suffix is passed in to help
    # differentiate builds. Append that if it's provided.
    dunamai_version="${dunamai_version}${RAPIDS_VERSION_SUFFIX:-}"
fi

echo -n "${dunamai_version}"
