#!/bin/bash
# A utility script that generates a package version
#
# Environment variables:
#
#   * RAPIDS_RELEASE_CANDIDATE_VERSION = Exact version to emit for a release-candidate
#                                         build. Its major/minor components must match
#                                         the source checkout's version.
#   * RAPIDS_RELEASE_CANDIDATE_SOURCE_VERSION = Original version of the source checkout,
#                                                used for major/minor validation. Defaults
#                                                to the first line of VERSION when unset.
set -euo pipefail
export RAPIDS_SCRIPT_NAME="rapids-generate-version"

if [[ -n "${RAPIDS_RELEASE_CANDIDATE_VERSION:-}" ]]; then
    readonly candidate_version="${RAPIDS_RELEASE_CANDIDATE_VERSION}"
    # Keep leading zeroes outside the capture groups so equivalent components
    # such as 0 and 00 compare equally below.
    readonly candidate_version_regex='^0*([0-9]+)\.0*([0-9]+)(\.[0-9]+)?$'
    if [[ ! "${candidate_version}" =~ ${candidate_version_regex} ]]; then
        echo "RAPIDS_RELEASE_CANDIDATE_VERSION must use a numeric YY.MM or YY.MM.XX format, got '${candidate_version}'" >&2
        exit 1
    fi
    source_version="${RAPIDS_RELEASE_CANDIDATE_SOURCE_VERSION:-}"
    if [[ -z "${source_version}" ]]; then
        if [[ ! -f VERSION ]]; then
            echo "RAPIDS_RELEASE_CANDIDATE_VERSION requires the source checkout's original version for major/minor validation;" >&2
            echo "provide it in VERSION or via RAPIDS_RELEASE_CANDIDATE_SOURCE_VERSION." >&2
            exit 1
        fi
        source_version="$(head -n 1 VERSION)"
    fi
    readonly source_version
    readonly source_version_regex='^0*([0-9]+)\.0*([0-9]+)(\.|$)'
    if [[ ! "${source_version}" =~ ${source_version_regex} ]]; then
        echo "source version must begin with two numeric components, got '${source_version}'" >&2
        exit 1
    fi
    # BASH_REMATCH[0] is the complete match and subsequent items are the
    # parenthesized captures. Save them before the candidate match replaces it.
    readonly source_major_minor="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
    [[ "${candidate_version}" =~ ${candidate_version_regex} ]]
    if [[ "${source_major_minor}" != "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" ]]; then
        echo "release-candidate version '${candidate_version}' does not match source major/minor '${source_major_minor}'" >&2
        exit 1
    fi
    echo -n "${candidate_version}"
    exit 0
fi

if rapids-is-release-build; then
    dunamai_version=$(python -m dunamai from git --format "{base}")
else
    # Non-release builds include the distance from the last tag as the alpha version.
    # We use Python to detect whether the nearest tag has a stage (e.g., "a" for alpha).
    # If it does, use {base}{stage}{distance} (e.g., "25.12.00a62").
    # If it doesn't (nearest tag is a release like v25.10.00), the stage is empty and
    # {base}{stage}{distance} would produce garbage (e.g., "25.10.000"). In that case,
    # we default to "rc" as the stage separator (e.g., "25.10.00rc0").
    dunamai_version=$(python -c "
from dunamai import Version
v = Version.from_git()
if v.stage:
    print(v.serialize(format='{base}{stage}{distance}'))
else:
    print(v.serialize(format='{base}rc{distance}'))
")

    # In some cases (like nightly builds), an additional suffix is passed in to help
    # differentiate builds. Append that if it's provided.
    dunamai_version="${dunamai_version}${RAPIDS_VERSION_SUFFIX:-}"
fi

echo -n "${dunamai_version}"
