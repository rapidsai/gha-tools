#!/bin/bash
# A utility script that configures sccache

export PARALLEL_LEVEL="${PARALLEL_LEVEL:-$(nproc --all --ignore=2)}"

# A frozen candidate can disable caching independently of normal CI. Clear
# inherited launchers before returning so later build scripts compile directly.
if [ "${RAPIDS_RELEASE_CANDIDATE_SCCACHE:-true}" = "false" ]; then
    unset RUSTC_WRAPPER
    export CMAKE_CUDA_COMPILER_LAUNCHER=""
    export CMAKE_CXX_COMPILER_LAUNCHER=""
    export CMAKE_C_COMPILER_LAUNCHER=""
    return 0
fi

# Configure sccache-dist
if test -n "${SCCACHE_DIST_AUTH_TOKEN:+x}"; then
    . rapids-configure-sccache-dist
fi

export RUSTC_WRAPPER=sccache
export CMAKE_CUDA_COMPILER_LAUNCHER=sccache
export CMAKE_CXX_COMPILER_LAUNCHER=sccache
export CMAKE_C_COMPILER_LAUNCHER=sccache
export SCCACHE_BUCKET="${SCCACHE_BUCKET:-rapids-sccache-east}"
export SCCACHE_IDLE_TIMEOUT="${SCCACHE_IDLE_TIMEOUT:-0}"
export SCCACHE_REGION="${SCCACHE_REGION:-us-east-2}"
export SCCACHE_S3_USE_SSL="${SCCACHE_S3_USE_SSL:-true}"

if [ "${CI:-false}" = "true" ]; then
    # Always require credentials to access the sccache bucket in CI
    export SCCACHE_S3_NO_CREDENTIALS=false
else
    # Configure sccache for read-only mode since no credentials
    # are available in local builds.
    export SCCACHE_S3_NO_CREDENTIALS="${SCCACHE_S3_NO_CREDENTIALS:-true}"
fi
